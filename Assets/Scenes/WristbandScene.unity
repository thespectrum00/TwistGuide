  runner: {fileID: 1517849522}
  band: {fileID: 556300876}
  placer: {fileID: 331264288}
  hintLabel: {fileID: 931912117}
  bandLabel: {fileID: 1132396886}
  bandDot: {fileID: 0}
  connectedColor: {r: 0.2, g: 0.78, b: 0.45, a: 1}
  missingColor: {r: 0.9, g: 0.35, b: 0.3, a: 1}
